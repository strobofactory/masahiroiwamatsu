---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { localeInfo, locales, localizedPath, publicLocales, type Locale } from '../../../i18n';

export async function getStaticPaths(){
  const notes = await getCollection('notes', ({data})=>!data.draft && publicLocales.includes(data.lang as any));
  return notes.map(note=>({params:{lang:note.data.lang,id:note.data.translationKey ?? note.data.slug ?? note.id},props:{note,lang:note.data.lang}}));
}

const { note, lang } = Astro.props as { note: any; lang: Locale };
const { Content } = await render(note);
const slug = note.data.translationKey ?? note.data.slug ?? note.id;
const translationKey = note.data.translationKey ?? slug;
const allNotes = await getCollection('notes', ({data})=>!data.draft);
const availableLocales = locales.filter(code => allNotes.some(candidate => candidate.data.lang === code && (candidate.data.translationKey ?? candidate.data.slug ?? candidate.id) === translationKey));
const canonicalPath = localizedPath(lang, `/notes/${slug}/`);
const canonicalUrl = new URL(canonicalPath, Astro.site).href;
const imageUrl = note.data.image ? new URL(note.data.image, Astro.site).href : undefined;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${canonicalUrl}#article`,
  headline: note.data.title,
  description: note.data.description,
  datePublished: note.data.pubDate.toISOString(),
  dateModified: (note.data.updatedDate ?? note.data.pubDate).toISOString(),
  mainEntityOfPage: canonicalUrl,
  url: canonicalUrl,
  inLanguage: localeInfo[lang].tag,
  author: {'@type':'Person','@id':'https://www.masahiroiwamatsu.com/#person',name:'Masahiro Iwamatsu',alternateName:'岩松正浩',url:new URL(localizedPath(lang,'/about/'),Astro.site).href},
  publisher: {'@type':'Person','@id':'https://www.masahiroiwamatsu.com/#person',name:'Masahiro Iwamatsu'},
  keywords: note.data.tags.join(', '),
  ...(imageUrl ? { image: imageUrl } : {})
};
---
<Base lang={lang} title={`${note.data.title} — NOMAD FIELD`} description={note.data.description} canonical={canonicalPath} translationPath={`/notes/${slug}/`} availableLocales={availableLocales} ogType="article" image={note.data.image}>
  <article class="article">
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)}></script>
    <a class="back" href={localizedPath(lang,'/notes/')}>← FIELD NOTES</a>
    <div class="eyebrow"><time datetime={note.data.pubDate.toISOString()}>{note.data.pubDate.toLocaleDateString(localeInfo[lang].dateLocale)}</time>{note.data.tags.length > 0 && <> / {note.data.tags.join(' · ')}</>}</div>
    <h1>{note.data.title}</h1>
    <p class="lead">{note.data.description}</p>
    {note.data.updatedDate && <p class="article-updated">UPDATED {note.data.updatedDate.toLocaleDateString(localeInfo[lang].dateLocale)}</p>}
    {note.data.image && <figure class="article-cover"><img src={note.data.image} alt={note.data.imageAlt ?? ''} />{note.data.imageCaption && <figcaption>{note.data.imageCaption}</figcaption>}</figure>}
    <div class="content"><Content /></div>
  </article>
</Base>
