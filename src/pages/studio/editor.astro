<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <meta name="theme-color" content="#f7f7f3" />
  <title>NOMAD FIELD Studio — Editor</title>
  <style>
    html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#f7f7f3}
    iframe{display:block;width:100%;height:100%;border:0;background:#f7f7f3}
  </style>
</head>
<body>
  <iframe id="studioEditor" src="/studio/legacy-editor/" title="NOMAD FIELD article editor"></iframe>
  <script is:inline>
    const frame=document.getElementById('studioEditor');
    const slug=new URLSearchParams(location.search).get('slug')||'';
    let timer=null;

    function prepareEditor(){
      let doc;
      try{doc=frame.contentDocument;}catch(_){return;}
      if(!doc)return;

      const style=doc.createElement('style');
      style.textContent=`section.panel:has(#articleSelect){display:none!important}.top a[href="/"]{display:none!important}.top:after{content:'ARTICLES';font-size:11px;letter-spacing:.12em;color:#777}.top{cursor:pointer}`;
      doc.head.appendChild(style);
      const top=doc.querySelector('.top');
      if(top)top.addEventListener('click',e=>{if(e.target.closest('button,input,select,textarea,a'))return;location.href='/studio/';});

      if(!slug)return;
      let attempts=0;
      clearInterval(timer);
      timer=setInterval(()=>{
        attempts++;
        const select=doc.getElementById('articleSelect');
        if(select&&[...select.options].some(o=>o.value===slug)){
          select.value=slug;
          select.dispatchEvent(new Event('change',{bubbles:true}));
          clearInterval(timer);
        }else if(attempts>80){clearInterval(timer);}
      },250);
    }

    frame.addEventListener('load',prepareEditor);
  </script>
</body>
</html>
