---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,6);
---
<Base>
  <main>
    <section class="hero"><div class="wrap"><div class="eyebrow">Masahiro Iwamatsu / Official Archive</div><h1>NOMAD<br/>FIELD</h1><div class="hero-copy"><p>AI、映像、健康、アプリ、旅、コーヒー、出版。分野ではなく、実際に見て、作って、試したことを記録する。</p><p>これは情報を量産するブログではなく、岩松正浩の一次情報を長期保存するためのフィールドノートです。</p></div></div></section>
    <section class="section"><div class="wrap"><div class="section-head"><h2>FIELD NOTES</h2><a href="/notes">VIEW ALL →</a></div><div class="notes">{notes.map((note,i)=><a class="card" href={`/notes/${note.id}/`}><div class="num">#{String(notes.length-i).padStart(3,'0')}</div><div><h3>{note.data.title}</h3><div class="meta"><span>{note.data.pubDate.toLocaleDateString('ja-JP')}</span>{note.data.tags.slice(0,3).map(t=><span>{t}</span>)}</div></div></a>)}</div></div></section>
    <section class="section"><div class="wrap about-grid"><h2>ONE PERSON.<br/>MANY FIELDS.</h2><div><p>映像制作を軸に、AI、自動化、アプリ開発、出版、音楽、ヘルスケアへ。活動領域が変わっても、原点は「自分で確かめる」ことです。</p><p>NOMAD FIELDは、その過程を企業やSNSではなく、自分の名前のドメインに残すための場所です。</p><p><a href="/about">PROFILE →</a></p></div></div></section>

    <section class="section"><div class="wrap"><div class="section-head"><h2>SERVICES & PROJECTS</h2><span class="eyebrow" style="margin:0">External sites</span></div><div class="services">
      <a class="service" href="https://www.strobofactory.net/" target="_blank" rel="noopener noreferrer"><small>01 / CREATIVE & AI</small><strong>STROBOFACTORY</strong><span>Visit site ↗</span></a>
      <a class="service" href="https://nextacademy.mykajabi.com/" target="_blank" rel="noopener noreferrer"><small>02 / EDUCATION</small><strong>NEXT ACADEMY</strong><span>Visit site ↗</span></a>
      <a class="service" href="https://hapiveri.com/" target="_blank" rel="noopener noreferrer"><small>03 / MEDIA & LIFESTYLE</small><strong>HAPIVERI</strong><span>Visit site ↗</span></a>
      <a class="service" href="https://www.hapiveri-healthcare.ai/" target="_blank" rel="noopener noreferrer"><small>04 / HEALTHCARE × AI</small><strong>HAPIVERI Healthcare.ai</strong><span>Visit site ↗</span></a>
    </div></div></section>
    <section class="section"><div class="wrap newsletter"><div><div class="eyebrow">Newsletter</div><h2>NEW NOTES,<br/>DIRECT.</h2><p>新しい記事と活動の記録をメールで届けます。Mailchimpの購読URLは公開前に接続します。</p></div><div class="eyebrow" style="margin:0">Mailchimp / connection pending</div></div></section>
  </main>
</Base>
