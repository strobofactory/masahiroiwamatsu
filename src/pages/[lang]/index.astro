---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { copy, localeInfo, publicLocales, localizedPath, type Locale } from '../../i18n';

export function getStaticPaths(){ return publicLocales.map(lang => ({ params:{ lang }, props:{ lang } })); }
const { lang } = Astro.props as { lang: Locale };
const t = copy[lang];
const notes = (await getCollection('notes', ({ data }) => !data.draft && data.lang === lang)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,6);
const noteSlug = (note) => note.data.translationKey ?? note.data.slug ?? note.id;
const canonical = localizedPath(lang, '/');
const homeIntro: Record<string,string> = {
  en: 'A first-person archive of Masahiro Iwamatsu across film, AI, healthcare, publishing, and other fields—preserving what he has actually seen, built, and tested on a domain under his own name.',
  es: 'Un archivo en primera persona de Masahiro Iwamatsu que cruza audiovisual, IA, salud, publicación y otros campos, y conserva en su propio dominio lo que realmente ha visto, creado y probado.',
  zh: '岩松正浩跨越影像、AI、健康、出版等领域的一手档案，把亲眼所见、亲手制作和实际测试的记录保存在自己的姓名域名下。',
  ko: '영상, AI, 헬스케어, 출판 등 여러 분야를 가로지르는 이와마츠 마사히로의 1차 기록 아카이브입니다. 직접 보고, 만들고, 시험한 것을 자신의 이름 도메인에 남깁니다.'
};
const socialImage = 'https://nomad-field-media.b-cdn.net/notes/why-nomad-field/1788700213218-Barcelona_00003.webp';
---
<Base lang={lang} canonical={canonical} translationPath="/" image={socialImage}>
  <main>
    <section class="hero"><div class="wrap"><div class="eyebrow">Masahiro Iwamatsu / Official Archive</div><h1>NOMAD<br/>FIELD</h1><p class="hero-intro">{homeIntro[lang]}</p></div></section>
    <section class="section media-section"><div class="wrap"><div class="section-head"><h2>FIELD NOTES</h2><a href={localizedPath(lang,'/notes/')}>{t.viewAll}</a></div><div class="home-notes">{notes.map((note,i)=><a class={`media-card ${note.data.image ? 'has-media' : 'no-media'} ${i===0 ? 'featured' : ''}`} href={localizedPath(lang,`/notes/${noteSlug(note)}/`)}>{note.data.image && <img class="media-bg" src={note.data.image} alt={note.data.imageAlt ?? note.data.title} loading={i===0 ? 'eager' : 'lazy'} />}{note.data.image && <div class="media-shade"></div>}<div class="media-card-content"><div class="num">#{String(notes.length-i).padStart(3,'0')}</div><div class="media-copy"><h3>{note.data.title}</h3><div class="meta"><span>{note.data.pubDate.toLocaleDateString(localeInfo[lang].dateLocale)}</span>{note.data.tags.slice(0,3).map(tag=><span>{tag}</span>)}</div></div></div></a>)}</div></div></section>
    <section class="section"><div class="wrap about-grid"><h2>ONE PERSON.<br/>MANY FIELDS.</h2><div><p>{t.aboutSummary1}</p><p>{t.aboutSummary2}</p><p><a href={localizedPath(lang,'/about/')}>PROFILE →</a></p></div></div></section>
  </main>
  <style is:global>
    .hero-intro{max-width:720px;margin:28px 0 0;font-size:15px;line-height:1.85;color:#444}.media-section{padding-top:48px}.home-notes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.media-card{position:relative;display:block;overflow:hidden;border:1px solid rgba(0,0,0,.07);background:var(--paper);min-height:280px;transition:transform .2s ease}.media-card:hover{transform:translateY(-2px)}.media-card.has-media{aspect-ratio:2.39/1;min-height:0}.media-card.featured{grid-column:1/-1}.media-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.media-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.06) 30%,rgba(0,0,0,.72) 100%)}.media-card-content{position:relative;z-index:2;display:flex;flex-direction:column;justify-content:space-between;height:100%;min-height:inherit;padding:22px 24px}.media-copy h3{margin:26px 0 14px;font-size:clamp(26px,3.1vw,44px);font-weight:650;line-height:1.08;letter-spacing:-.035em;max-width:850px}.featured .media-copy h3{font-size:clamp(34px,5vw,68px);max-width:980px}.has-media .num,.has-media .meta{color:rgba(255,255,255,.82)}.has-media .media-copy h3{color:#fff;text-shadow:0 1px 18px rgba(0,0,0,.18)}.no-media .media-card-content{background:#fff}@media(max-width:780px){.hero-intro{font-size:14px;margin-top:22px}.home-notes{grid-template-columns:1fr}.media-card.featured{grid-column:auto}.media-card.has-media{aspect-ratio:16/9}.media-copy h3,.featured .media-copy h3{font-size:30px}.media-card-content{padding:18px 20px}}
  </style>
</Base>
