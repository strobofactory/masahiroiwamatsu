---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <meta name="theme-color" content="#f7f7f3" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <title>NOMAD FIELD Studio — Articles</title>
  <style>
    :root{--bg:#f7f7f3;--ink:#121212;--muted:#777;--line:#d9d9d2;--paper:#fff;--ok:#245c34}
    *{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Helvetica Neue","Noto Sans JP",Arial,sans-serif}button,input{font:inherit}a{color:inherit;text-decoration:none}.shell{width:min(1040px,calc(100% - 28px));margin:0 auto;padding:34px 0 80px}.top{display:flex;align-items:center;justify-content:space-between;gap:18px;padding-bottom:22px;border-bottom:1px solid var(--line)}.brand{font-size:15px;font-weight:700;letter-spacing:.08em}.sub{font-size:11px;color:var(--muted);letter-spacing:.14em;text-transform:uppercase}.top-links{display:flex;gap:10px;align-items:center}.btn{border:1px solid #111;background:#111;color:#fff;padding:11px 15px;cursor:pointer;font-size:12px}.btn.secondary{background:transparent;color:#111;border-color:var(--line)}.panel{background:var(--paper);border:1px solid var(--line);padding:24px;margin-top:22px}.hidden{display:none!important}.hero{padding:42px 0 18px}.eyebrow{font-size:11px;color:var(--muted);letter-spacing:.14em;text-transform:uppercase}.hero h1{font-size:clamp(42px,8vw,80px);line-height:.95;letter-spacing:-.045em;margin:14px 0 18px}.hero p{margin:0;color:var(--muted);font-size:12px;line-height:1.8}.status{font-size:12px;color:var(--muted);line-height:1.7;margin-top:12px}.article-list{display:grid;border-top:1px solid var(--line);margin-top:18px}.article-row{display:grid;grid-template-columns:110px minmax(0,1fr) auto;align-items:stretch;border-bottom:1px solid var(--line);background:#fff}.article-row:hover{background:#f8f8f4}.article-main{padding:17px 18px;min-width:0}.article-date{padding:18px 0 18px 14px;font-size:10px;color:var(--muted);white-space:nowrap}.article-state{display:inline-block;font-size:9px;letter-spacing:.1em;border:1px solid var(--line);padding:3px 6px;margin-bottom:7px;color:var(--muted)}.article-state.public{color:var(--ok)}.article-title{font-size:16px;font-weight:600;line-height:1.45;overflow-wrap:anywhere}.article-meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:7px;font-size:10px;color:var(--muted)}.article-actions{display:flex;align-items:center;border-left:1px solid var(--line)}.article-actions a{padding:0 14px;font-size:10px;color:var(--muted);height:100%;display:flex;align-items:center}.article-actions a:hover{background:#f1f1ec;color:#111}.login h1{font-size:42px;margin:8px 0 24px}.field{margin-bottom:16px}.field label{display:block;font-size:10px;color:var(--muted);letter-spacing:.1em;margin-bottom:7px}.field input{width:100%;border:1px solid var(--line);padding:13px 14px;background:#fff;outline:none}@media(max-width:680px){.shell{padding-top:20px}.top{align-items:flex-start}.top-links .site{display:none}.article-row{grid-template-columns:1fr}.article-date{padding:14px 14px 0}.article-main{padding:10px 14px 15px}.article-actions{border-left:0;border-top:1px solid var(--line)}.article-actions a{padding:11px 14px;height:auto}.hero{padding-top:30px}}
  </style>
</head>
<body>
  <div class="shell">
    <div class="top">
      <div><div class="brand">NOMAD FIELD</div><div class="sub">Private publishing studio</div></div>
      <div class="top-links"><a class="btn secondary site" href="/" target="_blank">SITE ↗</a><a class="btn" href="/studio/editor/">新規記事</a></div>
    </div>

    <section id="loginPanel" class="panel login hidden">
      <div class="sub">Private</div><h1>STUDIO</h1>
      <div class="field"><label>STUDIO PASSWORD</label><input id="password" type="password" autocomplete="current-password" /></div>
      <button id="loginBtn" class="btn">LOGIN</button>
      <div id="loginStatus" class="status"></div>
    </section>

    <main id="articlesPanel" class="hidden">
      <section class="hero">
        <div class="eyebrow">Article archive</div>
        <h1>ARTICLES.</h1>
        <p>公開済み・下書きの記事を一覧で管理します。タイトルを押すと編集画面へ移動します。</p>
      </section>
      <section class="panel">
        <div style="display:flex;justify-content:space-between;gap:14px;align-items:center"><div class="sub">ALL NOTES</div><button id="refreshBtn" class="btn secondary">一覧更新</button></div>
        <div id="articleList" class="article-list"></div>
        <div id="listStatus" class="status"></div>
      </section>
    </main>
  </div>

  <script type="module" is:inline>
    const $=(id)=>document.getElementById(id);
    const esc=(v)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

    async function checkSession(){
      const res=await fetch('/api/studio/session',{cache:'no-store'});
      const data=await res.json();
      if(!data.configured){$('loginPanel').classList.remove('hidden');$('loginStatus').textContent='Studioの初期設定がまだ完了していません。';return;}
      if(data.authenticated){$('articlesPanel').classList.remove('hidden');loadArticles();}
      else $('loginPanel').classList.remove('hidden');
    }

    async function loadArticles(){
      const status=$('listStatus');status.textContent='記事一覧を読み込み中…';
      try{
        const res=await fetch('/api/studio/articles',{cache:'no-store'});
        const data=await res.json().catch(()=>({}));
        if(!res.ok)throw new Error(data.error||'記事一覧を取得できませんでした。');
        const articles=data.articles||[];
        $('articleList').innerHTML=articles.map(a=>{
          const state=a.draft?'下書き':'公開';
          const tags=(a.tags||[]).slice(0,4).map(tag=>`<span>${esc(tag)}</span>`).join('');
          const editUrl=`/studio/editor/?slug=${encodeURIComponent(a.slug)}`;
          const view=a.draft?'':`<a href="/notes/${encodeURIComponent(a.slug)}/" target="_blank">表示 ↗</a>`;
          return `<article class="article-row"><div class="article-date">${esc(a.pubDate||'')}</div><a class="article-main" href="${editUrl}"><span class="article-state ${a.draft?'':'public'}">${state}</span><div class="article-title">${esc(a.title)}</div><div class="article-meta">${tags}<span>/${esc(a.slug)}/</span></div></a><div class="article-actions"><a href="${editUrl}">編集 →</a>${view}</div></article>`;
        }).join('')||'<div style="padding:22px 0;color:#777;font-size:12px">記事はまだありません。</div>';
        status.textContent=`${articles.length}件の記事`;
      }catch(e){status.textContent=e.message;}
    }

    $('refreshBtn').onclick=loadArticles;
    $('loginBtn').onclick=async()=>{
      $('loginStatus').textContent='確認中…';
      const res=await fetch('/api/studio/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({password:$('password').value})});
      const data=await res.json().catch(()=>({}));
      if(!res.ok){$('loginStatus').textContent=data.error||'ログインできませんでした。';return;}
      $('loginPanel').classList.add('hidden');$('articlesPanel').classList.remove('hidden');loadArticles();
    };
    checkSession().catch(e=>{$('loginPanel').classList.remove('hidden');$('loginStatus').textContent=e.message;});
  </script>
</body>
</html>
