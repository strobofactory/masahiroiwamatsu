---
import Base from '../../../layouts/Base.astro';
import ProfileEvidence from '../../../components/ProfileEvidence.astro';
import { copy, publicLocales, localizedPath, type Locale } from '../../../i18n';

export function getStaticPaths(){ return publicLocales.map(lang => ({ params:{ lang }, props:{ lang } })); }
const { lang } = Astro.props as { lang: Locale };
const t = copy[lang];
const canonical = localizedPath(lang, '/about/');
---
<Base lang={lang} title={`ABOUT — Masahiro Iwamatsu`} description={t.defaultDescription} canonical={canonical} translationPath="/about/">
  <main>
    <section class="hero"><div class="wrap"><div class="eyebrow">{t.profileEyebrow}</div><h1>MASAHIRO<br/>IWAMATSU</h1></div></section>
    <section class="section"><div class="wrap about-grid"><h2>PRODUCER.<br/>BUILDER.<br/>PUBLISHER.</h2><div><p>{t.profileLine1}</p><p>{t.profileLine2}</p><p>{t.profileLine3}</p></div></div></section>
    <ProfileEvidence lang={lang} />
  </main>
</Base>
