<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <meta name="theme-color" content="#f7f7f3" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <title>NOMAD FIELD Studio — Articles</title>
  <style is:global>
    :root{--bg:#f7f7f3;--ink:#111;--muted:#787873;--line:#d8d8d1;--paper:#fff;--ok:#315d3b;--danger:#8a3030}
    *{box-sizing:border-box}
    html,body{margin:0;min-height:100%;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Helvetica Neue","Noto Sans JP",Arial,sans-serif}
    body{font-weight:400}button,input{font:inherit}a,a:visited{color:inherit;text-decoration:none}button{border-radius:0}
    .shell{width:min(1120px,calc(100% - 40px));margin:0 auto;padding:22px 0 56px}
    .top{min-height:58px;display:flex;align-items:flex-start;justify-content:space-between;gap:24px;border-bottom:1px solid var(--line)}
    .brand{font-size:14px;font-weight:750;letter-spacing:.095em;line-height:1.1}.sub{margin-top:3px;font-size:9px;color:var(--muted);letter-spacing:.18em;text-transform:uppercase}
    .top-links{display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:flex-end}
    .btn,.btn:visited{appearance:none;border:1px solid var(--ink);background:var(--ink);color:#fff;padding:9px 13px;cursor:pointer;font-size:10px;font-weight:600;letter-spacing:.02em;line-height:1;transition:background .16s ease,color .16s ease,border-color .16s ease}.btn:hover{background:#333;border-color:#333}.btn.secondary{background:transparent;color:var(--ink);border-color:var(--line)}.btn.secondary:hover{background:var(--paper);border-color:#aaa}.btn.danger{background:transparent;color:var(--danger);border-color:#cbb}.btn.danger:hover{background:#fff7f7;border-color:var(--danger)}.hidden{display:none!important}
    .hero{padding:30px 0 28px}.eyebrow{font-size:9px;color:var(--muted);letter-spacing:.19em;text-transform:uppercase}.hero h1{font-size:clamp(48px,7vw,78px);font-weight:800;line-height:.88;letter-spacing:-.055em;margin:14px 0 14px}.hero p{max-width:700px;margin:0;color:#595955;font-size:11px;line-height:1.7}
    .archive{border-top:1px solid var(--ink)}.archive-head{min-height:58px;display:flex;align-items:center;justify-content:space-between;gap:18px;border-bottom:1px solid var(--line)}.archive-title{font-size:9px;font-weight:650;letter-spacing:.18em}.archive-tools{display:flex;align-items:center;gap:10px}.filters{display:flex;align-items:center;gap:2px}.filter-btn{appearance:none;border:0;background:transparent;color:var(--muted);padding:7px 9px;cursor:pointer;font-size:9px;letter-spacing:.06em}.filter-btn:hover{color:var(--ink)}.filter-btn.active{background:var(--ink);color:#fff}.search{width:210px;border:1px solid var(--line);background:#fff;padding:8px 10px;font-size:10px;outline:none}.search:focus{border-color:#999}.refresh-btn{appearance:none;border:0;border-left:1px solid var(--line);background:transparent;padding:7px 0 7px 14px;color:var(--muted);cursor:pointer;font-size:9px;letter-spacing:.06em}.refresh-btn:hover{color:var(--ink)}
    .article-list{display:grid}.article-row{display:grid;grid-template-columns:130px minmax(0,1fr) 216px;min-height:96px;border-bottom:1px solid var(--line);background:transparent;transition:background .15s ease}.article-row:hover{background:rgba(255,255,255,.5)}.article-side{padding:17px 16px 15px 0;display:flex;flex-direction:column;align-items:flex-start;gap:8px;justify-content:center}.article-date{font-size:10px;color:var(--muted);letter-spacing:.03em;font-variant-numeric:tabular-nums}.article-state{display:inline-flex;align-items:center;justify-content:center;min-width:44px;border:1px solid var(--line);padding:4px 6px;font-size:8px;font-weight:650;letter-spacing:.1em;color:var(--muted);background:rgba(255,255,255,.5)}.article-state.public{color:var(--ok);border-color:#b8c8bb}.article-main{display:flex;flex-direction:column;justify-content:center;min-width:0;padding:15px 22px;border-left:1px solid var(--line)}.article-title{font-size:clamp(18px,1.8vw,23px);font-weight:650;line-height:1.2;letter-spacing:-.025em;overflow-wrap:anywhere;transition:opacity .15s ease}.article-main:hover .article-title{opacity:.55}.article-meta{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-top:8px;font-size:9px;color:var(--muted)}.article-tag{display:inline-flex;border:1px solid var(--line);padding:3px 6px;background:rgba(255,255,255,.35)}.article-slug{overflow-wrap:anywhere}.article-actions{display:grid;grid-template-columns:repeat(3,1fr);align-self:stretch;border-left:1px solid var(--line)}.article-actions a,.article-actions span,.article-actions button{appearance:none;border:0;background:transparent;display:flex;align-items:center;justify-content:center;padding:12px 7px;font-size:9px;font-weight:600;letter-spacing:.03em;color:#555;border-left:1px solid var(--line);transition:background .15s ease,color .15s ease;cursor:pointer}.article-actions>:first-child{border-left:0}.article-actions a:hover{background:var(--ink);color:#fff}.article-actions .delete-link{color:var(--danger)}.article-actions .delete-link:hover{background:#fff0f0;color:var(--danger)}.article-actions .disabled{color:#aaa;cursor:default}.article-actions button:disabled{opacity:.45;cursor:wait}
    .archive-foot{display:flex;justify-content:space-between;gap:20px;padding:11px 0;color:var(--muted);font-size:9px;letter-spacing:.04em}.status{font-size:10px;color:var(--muted);line-height:1.6}.empty{padding:36px 0;border-bottom:1px solid var(--line);font-size:11px;color:var(--muted)}.login{max-width:560px;margin:50px auto 0;padding:24px;border:1px solid var(--line);background:var(--paper)}.login h1{font-size:46px;line-height:.95;letter-spacing:-.045em;margin:8px 0 24px}.field{margin-bottom:16px}.field label{display:block;font-size:9px;color:var(--muted);letter-spacing:.12em;margin-bottom:7px}.field input{width:100%;border:1px solid var(--line);padding:12px;background:#fff;outline:none}.field input:focus{border-color:#777}.notice{margin:16px 0 0;padding:10px 12px;border:1px solid #c9d5cb;background:#f7fbf7;color:#315d3b;font-size:10px;line-height:1.6}
    @media(max-width:900px){.archive-head{align-items:flex-start;flex-direction:column;padding:13px 0;gap:10px}.archive-tools{width:100%;flex-wrap:wrap}.search{flex:1;min-width:180px}.article-row{grid-template-columns:120px minmax(0,1fr) 190px}}
    @media(max-width:820px){.shell{width:min(100% - 28px,1120px);padding-top:18px}.top{min-height:54px}.top-links .site{display:none}.hero{padding:24px 0 22px}.hero h1{font-size:clamp(48px,15vw,68px);margin:12px 0 12px}.article-row{grid-template-columns:1fr;min-height:0}.article-side{padding:14px 0 0;flex-direction:row;align-items:center;justify-content:flex-start}.article-main{padding:10px 0 15px;border-left:0}.article-title{font-size:20px}.article-meta{margin-top:7px}.article-actions{grid-template-columns:repeat(3,1fr);border-left:0;border-top:1px solid var(--line)}.article-actions a,.article-actions span,.article-actions button{padding:11px 8px}.archive-foot{padding:10px 0}.search{width:100%;flex-basis:100%}}
  </style>
</head>
<body>
  <div class="shell">
    <div class="top">
      <div><div class="brand">NOMAD FIELD</div><div class="sub">Private publishing studio</div></div>
      <div class="top-links"><a class="btn secondary site" href="/" target="_blank">SITE ↗</a><button id="logoutTopBtn" class="btn secondary hidden">ログアウト</button><a class="btn" href="/studio/editor/">新規記事</a></div>
    </div>

    <section id="loginPanel" class="login hidden">
      <div class="sub">Private</div><h1>STUDIO.</h1>
      <div class="field"><label>STUDIO PASSWORD</label><input id="password" type="password" autocomplete="current-password" /></div>
      <button id="loginBtn" class="btn">LOGIN</button>
      <div id="loginStatus" class="status" style="margin-top:14px"></div>
    </section>

    <main id="articlesPanel" class="hidden">
      <section class="hero">
        <div class="eyebrow">Article archive</div>
        <h1>ARTICLES.</h1>
        <p>新規作成、編集、公開・下書き、削除までここから管理します。削除時もBunny上の画像・動画は安全のため自動削除しません。</p>
        <div id="deletedNotice" class="notice hidden"></div>
      </section>

      <section class="archive">
        <div class="archive-head">
          <div class="archive-title">ALL NOTES</div>
          <div class="archive-tools">
            <input id="articleSearch" class="search" type="search" placeholder="タイトル / slug / タグを検索" autocomplete="off" />
            <div class="filters" aria-label="記事の絞り込み">
              <button class="filter-btn active" data-filter="all">すべて</button>
              <button class="filter-btn" data-filter="public">公開</button>
              <button class="filter-btn" data-filter="draft">下書き</button>
            </div>
            <button id="refreshBtn" class="refresh-btn">一覧更新 ↻</button>
          </div>
        </div>
        <div id="articleList" class="article-list"></div>
        <div class="archive-foot"><span id="listCount"></span><span id="listStatus" class="status"></span></div>
      </section>
    </main>
  </div>

  <script type="module" is:inline>
    const $=(id)=>document.getElementById(id);
    const esc=(v)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot',"'":'&#39;'}[c]));
    let articles=[];let currentFilter='all';let query='';

    async function checkSession(){
      const res=await fetch('/api/studio/session',{cache:'no-store'});const data=await res.json();
      if(!data.configured){$('loginPanel').classList.remove('hidden');$('loginStatus').textContent='Studioの初期設定がまだ完了していません。';return;}
      if(data.authenticated){showArticles();loadArticles();}else{$('loginPanel').classList.remove('hidden');}
    }

    function showArticles(){
      $('loginPanel').classList.add('hidden');$('articlesPanel').classList.remove('hidden');$('logoutTopBtn').classList.remove('hidden');
      const deleted=new URLSearchParams(location.search).get('deleted');
      if(deleted){$('deletedNotice').textContent=`「${deleted}」を削除しました。画像・動画ファイルはBunny上に残しています。`;$('deletedNotice').classList.remove('hidden');history.replaceState(null,'','/studio/');}
    }

    function visibleArticles(){
      const q=query.trim().toLowerCase();
      return articles.filter(a=>{
        const statusOk=currentFilter==='all'||(currentFilter==='draft'?a.draft:!a.draft);
        if(!statusOk)return false;
        if(!q)return true;
        const hay=[a.title,a.slug,...(a.tags||[])].join(' ').toLowerCase();
        return hay.includes(q);
      });
    }

    function renderArticles(){
      const visible=visibleArticles();
      $('articleList').innerHTML=visible.map(a=>{
        const state=a.draft?'下書き':'公開';
        const tags=(a.tags||[]).slice(0,4).map(tag=>`<span class="article-tag">${esc(tag)}</span>`).join('');
        const editUrl=`/studio/editor/?slug=${encodeURIComponent(a.slug)}`;
        const view=a.draft?'<span class="disabled">非公開</span>':`<a href="/notes/${encodeURIComponent(a.slug)}/" target="_blank" rel="noopener">表示 ↗</a>`;
        return `<article class="article-row"><div class="article-side"><span class="article-state ${a.draft?'':'public'}">${state}</span><time class="article-date">${esc(a.pubDate||'')}</time></div><a class="article-main" href="${editUrl}"><div class="article-title">${esc(a.title)}</div><div class="article-meta">${tags}<span class="article-slug">/${esc(a.slug)}/</span></div></a><div class="article-actions"><a href="${editUrl}">編集 →</a>${view}<button class="delete-link" data-delete-slug="${esc(a.slug)}" data-delete-title="${esc(a.title)}" data-delete-public="${a.draft?'0':'1'}">削除</button></div></article>`;
      }).join('')||'<div class="empty">該当する記事はありません。</div>';
      $('listCount').textContent=`${visible.length} / ${articles.length} ARTICLES`;
    }

    async function loadArticles(){
      const status=$('listStatus');status.textContent='LOADING…';
      try{const res=await fetch('/api/studio/articles',{cache:'no-store'});const data=await res.json().catch(()=>({}));if(!res.ok)throw new Error(data.error||'記事一覧を取得できませんでした。');articles=data.articles||[];renderArticles();status.textContent='';}catch(e){status.textContent=e.message;}
    }

    async function deleteArticle(button){
      const slug=button.dataset.deleteSlug||'';const title=button.dataset.deleteTitle||slug;const isPublic=button.dataset.deletePublic==='1';
      const message=`${isPublic?'公開中の記事':'下書き'}「${title}」を削除します。\n\n日本語と翻訳4言語の記事ファイルを削除します。画像・動画はBunny上に残します。\n\n続けますか？`;
      if(!confirm(message))return;
      const old=button.textContent;button.disabled=true;button.textContent='削除中…';$('listStatus').textContent='削除中…';
      try{
        const res=await fetch('/api/studio/delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({slug})});
        const data=await res.json().catch(()=>({}));if(!res.ok)throw new Error(data.error||'削除に失敗しました。');
        articles=articles.filter(a=>a.slug!==slug);renderArticles();$('listStatus').textContent=`「${title}」を削除しました。`;
      }catch(e){button.disabled=false;button.textContent=old;$('listStatus').textContent=e.message;}
    }

    document.querySelectorAll('.filter-btn').forEach(btn=>{btn.addEventListener('click',()=>{currentFilter=btn.dataset.filter||'all';document.querySelectorAll('.filter-btn').forEach(x=>x.classList.toggle('active',x===btn));renderArticles();});});
    $('articleSearch').addEventListener('input',e=>{query=e.target.value||'';renderArticles();});
    $('articleList').addEventListener('click',e=>{const btn=e.target.closest('[data-delete-slug]');if(btn){e.preventDefault();deleteArticle(btn);}});
    $('refreshBtn').onclick=loadArticles;
    $('logoutTopBtn').onclick=async()=>{await fetch('/api/studio/logout',{method:'POST'});location.reload();};
    $('loginBtn').onclick=async()=>{ $('loginStatus').textContent='確認中…';const res=await fetch('/api/studio/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({password:$('password').value})});const data=await res.json().catch(()=>({}));if(!res.ok){$('loginStatus').textContent=data.error||'ログインできませんでした。';return;}showArticles();loadArticles();};
    $('password').addEventListener('keydown',e=>{if(e.key==='Enter')$('loginBtn').click();});
    checkSession().catch(e=>{$('loginPanel').classList.remove('hidden');$('loginStatus').textContent=e.message;});
  </script>
</body>
</html>
