---
import { copy, localeInfo, locales, localizedPath, type Locale } from '../i18n';

const props = Astro.props;
const lang: Locale = (props.lang && locales.includes(props.lang)) ? props.lang : 'ja';
const t = copy[lang];
const title = props.title ?? 'NOMAD FIELD — Masahiro Iwamatsu';
const description = props.description ?? t.defaultDescription;
const canonical = props.canonical ?? Astro.url.pathname;
const ogType = props.ogType ?? 'website';
const image = props.image;
const translationPath = props.translationPath ?? (lang === 'ja' ? canonical : canonical.replace(new RegExp(`^/${lang}`), '') || '/');
const availableLocales: Locale[] = (props.availableLocales ?? locales).filter((item: Locale) => locales.includes(item));
const canonicalUrl = new URL(canonical, Astro.site);
const imageUrl = image ? new URL(image, Astro.site) : null;
const alternateLinks = availableLocales.map((code) => ({
  code,
  href: new URL(localizedPath(code, translationPath), Astro.site)
}));
const officialLinks = [
  { title: 'BOOKS', href: 'https://www.amazon.co.jp/stores/%E5%B2%A9%E6%9D%BE-%E6%AD%A3%E6%B5%A9/author/B07WFF6CRP', image: '/logos/books-placeholder.svg', alt: 'BOOKS' },
  { title: 'STROBOFACTORY', href: 'https://www.strobofactory.net/', image: '/logos/strobofactory-logo.svg', alt: 'STROBOFACTORY' },
  { title: 'NEXT ACADEMY', href: 'https://nextacademy.mykajabi.com/', image: '/logos/next-academy.png', alt: 'NEXT ACADEMY' },
  { title: 'HAPIVERI', href: 'https://hapiveri.com/', image: '/logos/hapiveri.png', alt: 'HAPIVERI' },
  { title: 'HAPIVERI Healthcare.ai', href: 'https://www.hapiveri-healthcare.ai/', image: '/logos/hapiveri-healthcare-ai.png', alt: 'HAPIVERI Healthcare.ai' }
];
---
<!doctype html>
<html lang={localeInfo[lang].tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f3" />
    <link rel="canonical" href={canonicalUrl} />
    {alternateLinks.map(({ code, href }) => <link rel="alternate" hreflang={localeInfo[code].tag} href={href} />)}
    {availableLocales.includes('ja') && <link rel="alternate" hreflang="x-default" href={new URL(localizedPath('ja', translationPath), Astro.site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="NOMAD FIELD RSS" href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="NOMAD FIELD" />
    <meta property="og:locale" content={localeInfo[lang].ogLocale} />
    {availableLocales.filter(code => code !== lang).map(code => <meta property="og:locale:alternate" content={localeInfo[code].ogLocale} />)}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': 'https://www.masahiroiwamatsu.com/#strobofactory',
          name: 'STROBOFACTORY INC.',
          alternateName: '株式会社ストロボファクトリー',
          url: 'https://www.strobofactory.net/'
        },
        {
          '@type': 'Person',
          '@id': 'https://www.masahiroiwamatsu.com/#person',
          name: 'Masahiro Iwamatsu',
          alternateName: '岩松正浩',
          url: 'https://www.masahiroiwamatsu.com',
          jobTitle: 'Representative Director / Producer',
          worksFor: { '@id': 'https://www.masahiroiwamatsu.com/#strobofactory' },
          sameAs: ['https://www.amazon.co.jp/stores/%E5%B2%A9%E6%9D%BE-%E6%AD%A3%E6%B5%A9/author/B07WFF6CRP'],
          knowsAbout: ['映像制作','AI','業務自動化','iOSアプリ','出版','音楽','ヘルスケア','オンライン教育','コーヒー']
        },
        {
          '@type': 'WebSite',
          '@id': 'https://www.masahiroiwamatsu.com/#website',
          url: 'https://www.masahiroiwamatsu.com',
          name: 'NOMAD FIELD',
          alternateName: 'Masahiro Iwamatsu Official Archive',
          description: t.defaultDescription,
          publisher: { '@id': 'https://www.masahiroiwamatsu.com/#person' },
          inLanguage: localeInfo[lang].tag
        }
      ]
    })}></script>
    <style is:global>
      :root{--bg:#f7f7f3;--ink:#121212;--muted:#777;--line:#d9d9d2;--paper:#fff;--font-main:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Helvetica Neue","Noto Sans JP","Noto Sans SC","Noto Sans KR",Arial,sans-serif}
      *{box-sizing:border-box}html{background:var(--bg);color:var(--ink);font-family:var(--font-main)}body{margin:0;min-height:100vh;font-family:var(--font-main);font-weight:400}button,input,textarea,select{font:inherit}a{color:inherit;text-decoration:none}img{max-width:100%;display:block}h1,h2,h3,h4,h5,h6,p,span,a,small,strong,time{font-family:var(--font-main)}
      .wrap{width:min(1180px,calc(100% - 36px));margin:0 auto}.header{position:sticky;top:0;z-index:20;background:rgba(247,247,243,.92);backdrop-filter:blur(12px);border-bottom:1px solid rgba(0,0,0,.06)}.header-in{height:70px;display:flex;align-items:center;justify-content:space-between}.brand{font-size:14px;font-weight:700;letter-spacing:.08em}.nav{display:flex;align-items:center;gap:22px;font-size:12px;font-weight:400;color:#555}.rss-link{display:grid;place-items:center;width:22px;height:22px;color:#555}.rss-link svg{display:block;width:16px;height:16px;fill:currentColor}.rss-link:hover{color:#111}
      .lang-menu{position:relative}.lang-menu summary{list-style:none;cursor:pointer;font-size:10px;letter-spacing:.08em;border:1px solid var(--line);padding:6px 8px;min-width:42px;text-align:center;background:rgba(255,255,255,.45)}.lang-menu summary::-webkit-details-marker{display:none}.lang-options{position:absolute;right:0;top:calc(100% + 7px);min-width:130px;background:var(--paper);border:1px solid var(--line);box-shadow:0 10px 30px rgba(0,0,0,.07);z-index:30}.lang-options a{display:flex;justify-content:space-between;gap:12px;padding:10px 12px;border-bottom:1px solid var(--line);font-size:11px;white-space:nowrap}.lang-options a:last-child{border-bottom:0}.lang-options a[aria-current="page"]{font-weight:700;background:#f3f3ee}.lang-options a:hover{background:#f7f7f3}
      .hero{padding:48px 0 44px;border-bottom:1px solid var(--line)}.eyebrow{font-size:11px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin-bottom:18px}.hero h1{font-size:clamp(46px,8vw,110px);font-weight:800;line-height:.92;letter-spacing:-.05em;margin:0;max-width:1000px}
      .section{padding:54px 0;border-bottom:1px solid var(--line)}.section-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:28px}.section-head h2{font-size:12px;font-weight:600;letter-spacing:.14em;margin:0}.section-head a{font-size:12px;font-weight:400;color:var(--muted)}
      .notes{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{background:var(--paper);min-height:300px;padding:24px;display:flex;flex-direction:column;justify-content:space-between;border:1px solid rgba(0,0,0,.06);transition:transform .2s ease}.card:hover{transform:translateY(-2px)}.num{font-size:11px;font-weight:400;color:var(--muted);letter-spacing:.12em}.card h3{font-size:28px;font-weight:600;line-height:1.18;letter-spacing:-.025em;margin:48px 0 18px}.meta{font-size:11px;font-weight:400;color:var(--muted);display:flex;gap:12px;flex-wrap:wrap}
      .about-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px}.about-grid h2{font-size:42px;font-weight:700;letter-spacing:-.035em;margin:0}.about-grid p{margin:0 0 18px;font-weight:400;line-height:1.9;color:#333}.profile-links{border-top:1px solid var(--line)}.profile-links a{display:flex;justify-content:space-between;gap:20px;padding:18px 0;border-bottom:1px solid var(--line);font-size:14px}.profile-links a:hover{opacity:.55}
      .site-footer{border-top:1px solid var(--line);padding:38px 0 52px}.footer-head{display:flex;justify-content:space-between;align-items:baseline;gap:20px;margin-bottom:20px}.footer-head h2{margin:0;font-size:11px;font-weight:600;letter-spacing:.14em}.footer-head span{font-size:10px;color:var(--muted);letter-spacing:.12em;text-transform:uppercase}.footer-links{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}.footer-link{display:flex;min-width:0;flex-direction:column;gap:10px;padding:10px;border:1px solid var(--line);background:rgba(255,255,255,.38);font-size:11px;font-weight:500;line-height:1.4;transition:transform .2s ease,background .2s ease}.footer-link:hover{transform:translateY(-2px);background:var(--paper)}.footer-logo{width:100%;aspect-ratio:16/10;object-fit:contain;padding:10px;background:#fff;border:1px solid rgba(0,0,0,.05)}.footer-link-label{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.footer-link-label span:first-child{overflow-wrap:anywhere}.footer-newsletter-panel{margin-top:30px;padding:34px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:end}.footer-newsletter-copy h2{font-size:36px;font-weight:700;letter-spacing:-.035em;line-height:1;margin:0 0 18px}.footer-newsletter-copy p{margin:0;max-width:560px;font-size:14px;line-height:1.9;color:#444}.newsletter-form{align-self:end;width:100%}.newsletter-form-row{display:flex;align-items:center;border-bottom:1px solid #111}.newsletter-form-row input{width:100%;min-width:0;border:0;background:transparent;padding:16px 0;font-size:15px;outline:none}.newsletter-form-row button{border:0;background:transparent;padding:16px 0 16px 18px;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap}.mailchimp-honeypot{position:absolute;left:-5000px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.footer-bottom{padding-top:24px;font-size:11px;font-weight:400;color:var(--muted);display:flex;justify-content:flex-start;gap:20px;flex-wrap:wrap}
      .article{width:min(920px,calc(100% - 36px));margin:0 auto;padding:76px 0}.article h1{font-size:clamp(40px,7vw,72px);font-weight:700;line-height:1.06;letter-spacing:-.035em;margin:20px 0}.article .lead{font-size:18px;font-weight:400;line-height:1.8;color:#444}.article-cover{width:100%;margin:42px 0 0}.article-cover img{width:100%;aspect-ratio:2.39/1;object-fit:cover}.article-cover figcaption{margin-top:9px;color:var(--muted);font-size:11px;line-height:1.6}.article .content{margin-top:52px;font-family:var(--font-main);font-size:17px;font-weight:400;line-height:2}.article .content h2{font-family:var(--font-main);font-size:30px;font-weight:700;letter-spacing:-.025em;margin-top:60px}.article .content h3{font-size:22px;font-weight:600;margin-top:42px}.article .content a{text-decoration:underline;text-underline-offset:3px}.article .content blockquote{margin:36px 0;padding-left:20px;border-left:1px solid var(--ink);color:#444}.article .content img{width:100%;aspect-ratio:2.39/1;object-fit:cover;margin:42px 0}.article-updated{margin-top:-8px;color:var(--muted);font-size:11px}.back{font-size:12px;font-weight:400;color:var(--muted)}
      @media(max-width:1080px){.footer-links{grid-template-columns:repeat(3,1fr)}}@media(max-width:780px){.nav{gap:12px}.nav>a:not(.rss-link){display:none}.hero{padding:42px 0 40px}.about-grid{grid-template-columns:1fr}.notes{grid-template-columns:1fr}.card{min-height:240px}.card h3{margin-top:34px}.about-grid h2{font-size:34px}.footer-links{grid-template-columns:repeat(2,minmax(0,1fr))}.footer-link{padding:9px}.footer-newsletter-panel{grid-template-columns:1fr;gap:24px}.footer-newsletter-copy h2{font-size:32px}}@media(max-width:520px){.footer-links{grid-template-columns:repeat(2,minmax(0,1fr))}}
    </style>
  </head>
  <body>
    <header class="header">
      <div class="wrap header-in">
        <a class="brand" href="/studio/">NOMAD FIELD</a>
        <nav class="nav" aria-label="Primary">
          <a href={localizedPath(lang, '/notes/')}>{t.navNotes}</a>
          <a href={localizedPath(lang, '/about/')}>{t.navAbout}</a>
          <details class="lang-menu">
            <summary aria-label="Language">{localeInfo[lang].short}</summary>
            <div class="lang-options">
              {alternateLinks.map(({ code, href }) => <a href={href} aria-current={code === lang ? 'page' : undefined}><span>{localeInfo[code].label}</span><span>{code === lang ? '●' : ''}</span></a>)}
            </div>
          </details>
          <a class="rss-link" href="/rss.xml" aria-label="RSS Feed" title="RSS Feed"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="19" r="2"></circle><path d="M3 10.5v3a7.5 7.5 0 0 1 7.5 7.5h3C13.5 15.2 8.8 10.5 3 10.5z"></path><path d="M3 3v3a15 15 0 0 1 15 15h3C21 11.1 12.9 3 3 3z"></path></svg></a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-head"><h2>OFFICIAL LINKS</h2><span>{t.externalSites}</span></div>
        <div class="footer-links">
          {officialLinks.map((link) => (
            <a class="footer-link" href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`${link.title} ↗`}>
              <img class="footer-logo" src={link.image} alt={link.alt} loading="lazy" />
              <div class="footer-link-label"><span>{link.title}</span><span>↗</span></div>
            </a>
          ))}
        </div>
        <section id="newsletter" class="footer-newsletter-panel">
          <div class="footer-newsletter-copy">
            <div class="eyebrow">{t.newsletterEyebrow}</div>
            <h2 set:html={t.newsletterTitle.replace(/\n/g, '<br/>')}></h2>
            <p set:html={t.newsletterBody.replace(/\n/g, '<br/>')}></p>
          </div>
          <form class="newsletter-form" action="https://hapiveri.us10.list-manage.com/subscribe/post?u=75ebe487c22c5ad56ec9ff9ba&amp;id=4bd846e334&amp;f_id=00e9f6e5f0" method="post" target="_blank">
            <label class="sr-only" for={`footer-newsletter-email-${lang}`}>Email Address</label>
            <div class="newsletter-form-row"><input id={`footer-newsletter-email-${lang}`} type="email" name="EMAIL" placeholder={t.emailPlaceholder} required /><button type="submit" name="subscribe">{t.subscribe}</button></div>
            <div aria-hidden="true" class="mailchimp-honeypot"><input type="text" name="b_75ebe487c22c5ad56ec9ff9ba_4bd846e334" tabindex="-1" value="" /></div>
          </form>
        </section>
        <div class="footer-bottom"><span>© {new Date().getFullYear()} MASAHIRO IWAMATSU</span></div>
      </div>
    </footer>
  </body>
</html>