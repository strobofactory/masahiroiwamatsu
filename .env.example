# NOMAD FIELD Studio authentication
STUDIO_PASSWORD=
STUDIO_SESSION_SECRET=

# Fine-grained GitHub token with Contents read/write access to strobofactory/masahiroiwamatsu
GITHUB_TOKEN=

# Remote MCP for Claude custom connectors (Auth0 is the OAuth authorization server)
# The resource URL must exactly match the URL entered in Claude.
MCP_RESOURCE_URL=https://www.masahiroiwamatsu.com/api/mcp
MCP_SITE_BASE_URL=https://www.masahiroiwamatsu.com
MCP_GITHUB_BRANCH=main
MCP_OAUTH_ISSUER=https://YOUR_AUTH0_DOMAIN/
MCP_OAUTH_JWKS_URL=https://YOUR_AUTH0_DOMAIN/.well-known/jwks.json
# Public Client ID of the pre-registered Claude Auth0 application (not its secret).
MCP_OAUTH_CLIENT_ID=
# Exact Auth0 user `sub` allowed to use the MCP tools.
MCP_OWNER_SUB=
MCP_RATE_LIMIT_PER_MINUTE=60

# Bunny Storage (photos)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_CDN_URL=https://your-pull-zone.b-cdn.net
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com

# Bunny Stream (video)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
