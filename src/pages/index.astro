---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,6);
---
<Base>
  <main>
    <section class="hero"><div class="wrap"><div class="eyebrow">Masahiro Iwamatsu / Official Archive</div><h1>NOMAD<br/>FIELD</h1></div></section>
    <section class="section media-section"><div class="wrap"><div class="section-head"><h2>FIELD NOTES</h2><a href="/notes">VIEW ALL →</a></div><div class="home-notes">{notes.map((note,i)=><a class={`media-card ${note.data.image ? 'has-media' : 'no-media'} ${i===0 ? 'featured' : ''}`} href={`/notes/${note.id}/`}>{note.data.image && <img class="media-bg" src={note.data.image} alt={note.data.imageAlt ?? note.data.title} loading={i===0 ? 'eager' : 'lazy'} />}{note.data.image && <div class="media-shade"></div>}<div class="media-card-content"><div class="num">#{String(notes.length-i).padStart(3,'0')}</div><div class="media-copy"><h3>{note.data.title}</h3><div class="meta"><span>{note.data.pubDate.toLocaleDateString('ja-JP')}</span>{note.data.tags.slice(0,3).map(t=><span>{t}</span>)}</div></div></div></a>)}</div></div></section>
    <section class="section"><div class="wrap about-grid"><h2>ONE PERSON.<br/>MANY FIELDS.</h2><div><p>映像制作を軸に、AI、自動化、アプリ開発、出版、音楽、ヘルスケアへ。活動領域が変わっても、原点は「自分で確かめる」ことです。</p><p>NOMAD FIELDは、その過程を企業やSNSではなく、自分の名前のドメインに残すための場所です。</p><p><a href="/about">PROFILE →</a></p></div></div></section>
    <section id="newsletter" class="section"><div class="wrap newsletter"><div><div class="eyebrow">Newsletter</div><h2>NEW NOTES,<br/>DIRECT.</h2><p>新しい記事と活動の記録をメールで届けます。</p></div><form class="newsletter-form" action="https://hapiveri.us10.list-manage.com/subscribe/post?u=75ebe487c22c5ad56ec9ff9ba&amp;id=4bd846e334&amp;f_id=00e9f6e5f0" method="post" target="_blank"><label class="sr-only" for="newsletter-email">Email Address</label><div class="newsletter-form-row"><input id="newsletter-email" type="email" name="EMAIL" placeholder="Email address" required /><button type="submit" name="subscribe">SUBSCRIBE →</button></div><div aria-hidden="true" class="mailchimp-honeypot"><input type="text" name="b_75ebe487c22c5ad56ec9ff9ba_4bd846e334" tabindex="-1" value="" /></div><p class="newsletter-note">登録はMailchimpで管理されます。</p></form></div></section>
  </main>
  <style is:global>
    .media-section{padding-top:48px}
    .home-notes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
    .media-card{position:relative;display:block;overflow:hidden;border:1px solid rgba(0,0,0,.07);background:var(--paper);min-height:280px;transition:transform .2s ease}
    .media-card:hover{transform:translateY(-2px)}
    .media-card.has-media{aspect-ratio:2.39/1;min-height:0}
    .media-card.featured{grid-column:1/-1}
    .media-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
    .media-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.06) 30%,rgba(0,0,0,.72) 100%)}
    .media-card-content{position:relative;z-index:2;display:flex;flex-direction:column;justify-content:space-between;height:100%;min-height:inherit;padding:22px 24px}
    .media-copy h3{margin:26px 0 14px;font-size:clamp(26px,3.1vw,44px);font-weight:650;line-height:1.08;letter-spacing:-.035em;max-width:850px}
    .featured .media-copy h3{font-size:clamp(34px,5vw,68px);max-width:980px}
    .has-media .num,.has-media .meta{color:rgba(255,255,255,.82)}
    .has-media .media-copy h3{color:#fff;text-shadow:0 1px 18px rgba(0,0,0,.18)}
    .no-media .media-card-content{background:#fff}
    .newsletter-form{align-self:end;width:100%}
    .newsletter-form-row{display:flex;align-items:center;border-bottom:1px solid #111}
    .newsletter-form-row input{width:100%;min-width:0;border:0;background:transparent;padding:16px 0;font-size:15px;outline:none}
    .newsletter-form-row button{border:0;background:transparent;padding:16px 0 16px 18px;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap}
    .newsletter-note{margin:10px 0 0!important;font-size:11px!important;color:var(--muted)!important}
    .mailchimp-honeypot{position:absolute;left:-5000px}
    .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    @media(max-width:780px){.home-notes{grid-template-columns:1fr}.media-card.featured{grid-column:auto}.media-card.has-media{aspect-ratio:16/9}.media-copy h3,.featured .media-copy h3{font-size:30px}.media-card-content{padding:18px 20px}.newsletter-form{margin-top:18px}}
  </style>
</Base>