---
const {
  title = 'NOMAD FIELD — Masahiro Iwamatsu',
  description = 'Masahiro Iwamatsu の公式アーカイブ。AI、映像、健康、アプリ、旅、コーヒー、出版についてのフィールドノート。',
  canonical = Astro.url.pathname
} = Astro.props;
const canonicalUrl = new URL(canonical, Astro.site);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="NOMAD FIELD RSS" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="NOMAD FIELD" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Person',
          '@id': 'https://masahiroiwamatsu.com/#person',
          name: 'Masahiro Iwamatsu',
          alternateName: '岩松正浩',
          url: 'https://masahiroiwamatsu.com'
        },
        {
          '@type': 'WebSite',
          '@id': 'https://masahiroiwamatsu.com/#website',
          url: 'https://masahiroiwamatsu.com',
          name: 'NOMAD FIELD',
          publisher: { '@id': 'https://masahiroiwamatsu.com/#person' },
          inLanguage: 'ja'
        }
      ]
    })}></script>
    <style is:global>
      :root {
        --bg:#f7f7f3;
        --ink:#121212;
        --muted:#777;
        --line:#d9d9d2;
        --paper:#fff;
        --font-main:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Helvetica Neue","Noto Sans JP",Arial,sans-serif;
      }
      *{box-sizing:border-box}
      html{background:var(--bg);color:var(--ink);font-family:var(--font-main)}
      body{margin:0;min-height:100vh;font-family:var(--font-main);font-weight:400}
      button,input,textarea,select{font:inherit}
      a{color:inherit;text-decoration:none}
      img{max-width:100%;display:block}
      h1,h2,h3,h4,h5,h6,p,span,a,small,strong,time{font-family:var(--font-main)}

      .wrap{width:min(1180px,calc(100% - 36px));margin:0 auto}
      .header{position:sticky;top:0;z-index:20;background:rgba(247,247,243,.92);backdrop-filter:blur(12px);border-bottom:1px solid rgba(0,0,0,.06)}
      .header-in{height:70px;display:flex;align-items:center;justify-content:space-between}
      .brand{font-size:14px;font-weight:700;letter-spacing:.08em}
      .nav{display:flex;gap:24px;font-size:12px;font-weight:400;color:#555}

      .hero{padding:88px 0 72px;border-bottom:1px solid var(--line)}
      .eyebrow{font-size:11px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin-bottom:18px}
      .hero h1{font-size:clamp(46px,8vw,110px);font-weight:800;line-height:.92;letter-spacing:-.05em;margin:0;max-width:1000px}
      .hero-copy{margin-top:28px;display:grid;grid-template-columns:1fr 1fr;gap:30px}
      .hero-copy p{margin:0;font-size:15px;font-weight:400;line-height:1.9;max-width:560px}

      .section{padding:54px 0;border-bottom:1px solid var(--line)}
      .section-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:28px}
      .section-head h2{font-size:12px;font-weight:600;letter-spacing:.14em;margin:0}
      .section-head a{font-size:12px;font-weight:400;color:var(--muted)}

      .notes{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
      .card{background:var(--paper);min-height:300px;padding:24px;display:flex;flex-direction:column;justify-content:space-between;border:1px solid rgba(0,0,0,.06);transition:transform .2s ease}
      .card:hover{transform:translateY(-2px)}
      .num{font-size:11px;font-weight:400;color:var(--muted);letter-spacing:.12em}
      .card h3{font-size:28px;font-weight:600;line-height:1.18;letter-spacing:-.025em;margin:48px 0 18px}
      .meta{font-size:11px;font-weight:400;color:var(--muted);display:flex;gap:12px;flex-wrap:wrap}

      .about-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px}
      .about-grid h2{font-size:42px;font-weight:700;letter-spacing:-.035em;margin:0}
      .about-grid p{margin:0 0 18px;font-weight:400;line-height:1.9;color:#333}

      .logo-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px}
      .logo-card{display:flex;flex-direction:column;gap:12px;padding:16px;background:rgba(255,255,255,.5);border:1px solid var(--line);transition:transform .2s ease,background .2s ease}
      .logo-card:hover{transform:translateY(-2px);background:var(--paper)}
      .logo-card img{width:100%;aspect-ratio:16/10;object-fit:cover;border:1px solid rgba(0,0,0,.06);background:#fff}
      .logo-card span{font-size:12px;font-weight:500;color:var(--muted);letter-spacing:.02em}

      .newsletter{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:end}
      .newsletter h2{font-size:40px;font-weight:700;letter-spacing:-.035em;margin:0}
      .newsletter p{font-weight:400;color:var(--muted);line-height:1.8}
      .form{display:flex;border-bottom:1px solid #111}
      .form input{width:100%;background:transparent;border:0;padding:16px 0;font-size:15px;font-weight:400;outline:none}
      .form button{background:transparent;border:0;font-size:12px;font-weight:600;cursor:pointer;padding:0 4px 0 18px}
      .footer{padding:34px 0 60px;font-size:11px;font-weight:400;color:var(--muted);display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}

      .article{width:min(760px,calc(100% - 36px));margin:0 auto;padding:76px 0}
      .article h1{font-size:clamp(40px,7vw,72px);font-weight:700;line-height:1.06;letter-spacing:-.035em;margin:20px 0}
      .article .lead{font-size:18px;font-weight:400;line-height:1.8;color:#444}
      .article .content{margin-top:52px;font-family:var(--font-main);font-size:17px;font-weight:400;line-height:2}
      .article .content h2{font-family:var(--font-main);font-size:30px;font-weight:700;letter-spacing:-.025em;margin-top:60px}
      .article .content a{text-decoration:underline;text-underline-offset:3px}
      .back{font-size:12px;font-weight:400;color:var(--muted)}

      @media(max-width:1080px){.logo-grid{grid-template-columns:repeat(3,1fr)}}
      @media(max-width:780px){.nav{gap:13px}.hero{padding-top:64px}.hero-copy,.about-grid,.newsletter{grid-template-columns:1fr}.notes,.logo-grid{grid-template-columns:1fr}.card{min-height:240px}.card h3{margin-top:34px}.about-grid h2,.newsletter h2{font-size:34px}}
    </style>
  </head>
  <body>
    <header class="header"><div class="wrap header-in"><a class="brand" href="/">NOMAD FIELD</a><nav class="nav"><a href="/notes">NOTES</a><a href="https://www.amazon.co.jp/stores/%E5%B2%A9%E6%9D%BE-%E6%AD%A3%E6%B5%A9/author/B07WFF6CRP" target="_blank" rel="noopener noreferrer">BOOKS ↗</a><a href="/about">ABOUT</a><a href="/rss.xml">RSS</a></nav></div></header>
    <slot />
    <footer class="wrap footer"><span>© {new Date().getFullYear()} MASAHIRO IWAMATSU</span><span>Independent field notes for the AI age.</span></footer>
  </body>
</html>