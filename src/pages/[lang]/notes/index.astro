---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { copy, localeInfo, publicLocales, localizedPath, type Locale } from '../../../i18n';

export function getStaticPaths(){ return publicLocales.map(lang => ({ params:{ lang }, props:{ lang } })); }
const { lang } = Astro.props as { lang: Locale };
const t = copy[lang];
const notes = (await getCollection('notes', ({data})=>!data.draft && data.lang === lang)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const noteSlug = (note) => note.data.slug ?? note.id;
const canonical = localizedPath(lang, '/notes/');
---
<Base lang={lang} title="FIELD NOTES — Masahiro Iwamatsu" canonical={canonical} translationPath="/notes/">
  <main>
    <section class="hero"><div class="wrap"><div class="eyebrow">{t.archive}</div><h1>FIELD NOTES</h1></div></section>
    <section class="section media-section"><div class="wrap"><div class="archive-notes">{notes.map((note,i)=><a class={`media-card ${note.data.image ? 'has-media' : 'no-media'} ${i===0 ? 'featured' : ''}`} href={localizedPath(lang,`/notes/${noteSlug(note)}/`)}>{note.data.image && <img class="media-bg" src={note.data.image} alt={note.data.imageAlt ?? note.data.title} loading={i===0 ? 'eager' : 'lazy'} />}{note.data.image && <div class="media-shade"></div>}<div class="media-card-content"><div class="num">#{String(notes.length-i).padStart(3,'0')}</div><div class="media-copy"><h3>{note.data.title}</h3><div class="meta"><span>{note.data.pubDate.toLocaleDateString(localeInfo[lang].dateLocale)}</span>{note.data.tags.map(tag=><span>{tag}</span>)}</div></div></div></a>)}</div></div></section>
  </main>
  <style is:global>
    .media-section{padding-top:48px}.archive-notes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.media-card{position:relative;display:block;overflow:hidden;border:1px solid rgba(0,0,0,.07);background:var(--paper);min-height:280px;transition:transform .2s ease}.media-card:hover{transform:translateY(-2px)}.media-card.has-media{aspect-ratio:2.39/1;min-height:0}.media-card.featured{grid-column:1/-1}.media-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.media-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.06) 30%,rgba(0,0,0,.72) 100%)}.media-card-content{position:relative;z-index:2;display:flex;flex-direction:column;justify-content:space-between;height:100%;min-height:inherit;padding:22px 24px}.media-copy h3{margin:26px 0 14px;font-size:clamp(26px,3vw,42px);font-weight:650;line-height:1.08;letter-spacing:-.035em;max-width:850px}.featured .media-copy h3{font-size:clamp(34px,5vw,68px);max-width:980px}.has-media .num,.has-media .meta{color:rgba(255,255,255,.82)}.has-media .media-copy h3{color:#fff;text-shadow:0 1px 18px rgba(0,0,0,.18)}.no-media .media-card-content{background:#fff}@media(max-width:780px){.archive-notes{grid-template-columns:1fr}.media-card.featured{grid-column:auto}.media-card.has-media{aspect-ratio:16/9}.media-copy h3,.featured .media-copy h3{font-size:30px}.media-card-content{padding:18px 20px}}
  </style>
</Base>
